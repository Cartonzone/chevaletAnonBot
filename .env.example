# ChevaletAnonBot configuration. Copy to `.env` and fill in.
#
# `.env` is git-ignored — never commit real tokens. The compose stacks read this
# file through `env_file`, so EVERY key documented here reaches the bot process;
# you do not need to edit docker-compose.yml when a key is added.
#
# Values below are safe placeholders. `.env.example` itself is also used by CI to
# validate the compose files (`docker compose --env-file .env.example config`).
#
# Keys marked [required] make the bot REFUSE TO START when unset/empty — that is
# deliberate (fail closed instead of running half-configured).

# --- Telegram ---------------------------------------------------------------
# [required] the bot refuses to start when this is unset/empty.
BOT_TOKEN=123456789:AAExampleTokenNotRealChangeMe
# Outbound proxy for reaching Telegram (and the AI endpoint), if your host can't
# reach api.telegram.org directly. Leave empty to connect directly.
# Examples: socks5://127.0.0.1:1080  |  http://user:pass@host:port
PROXY=
# [required] the bot refuses to start when this is unset/empty.
REPORT_CHAT_ID=-1001234567890
ERROR_CHAT_ID=-1001234567890
# Admin user ids, separated by "|" (not commas). [required]
ADMINS=111111111
SELLER_ADMIN=username
SUPPORT_ADMIN=username

# --- Database (PostgreSQL) --------------------------------------------------
# DB_HOST is overridden to the compose service in Docker; keep it localhost for
# running the bot binary directly.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydatabase
DB_USER=root
DB_PASS=change-me
# TLS mode for the PostgreSQL connection (pgx/libpq semantics):
#   disable | allow | prefer | require | verify-ca | verify-full
# "prefer" (v3.4.1 default) tries TLS and falls back to plaintext, which is right
# for the container-internal network; use require/verify-full for remote DBs.
DB_SSLMODE=prefer
# Bounded startup (v3.4.1): seconds to wait for the TCP/auth handshake before
# failing fast instead of hanging the boot invisibly.
DB_CONNECT_TIMEOUT_SECONDS=5
# pgx pool ceiling (v3.4.1). The bot is single-dispatcher; 20 leaves headroom for
# background jobs. Keep below PostgreSQL max_connections minus other clients.
DB_MAX_CONNS=20

# --- Runtime state ----------------------------------------------------------
# Where runtime-tunable settings (donation button, AI url/session) are persisted.
# Optional; defaults to ./dynamic_settings.json. In Docker this MUST point at a
# mounted path, otherwise every redeploy recreates the container and resets
# whatever an admin configured (see deploy/go/docker-compose.cutover.yml).
DYNSET_PATH=/app/state/dynamic_settings.json

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# --- Limits -----------------------------------------------------------------
# [required] the bot refuses to start when this is unset/empty.
MAX_NAME_LENGTH=100
# [required] the bot refuses to start when this is unset/empty.
DEFAULT_CID_LIMIT=2
# [required] the bot refuses to start when this is unset/empty.
MAX_CID_LENGTH=30
# [required] the bot refuses to start when this is unset/empty.
MIN_CID_LENGTH=5

# --- Health / watchdog (v3.4.1 HTTP endpoints) ------------------------------
# The bot serves HTTP on 127.0.0.1:HEALTH_PORT (loopback only):
#   GET /healthz  liveness — process + poll/dispatch progress
#   GET /readyz   readiness — DB ping, assets, backup dir
# The compose healthchecks probe /healthz with busybox wget.
# [required] the bot refuses to start when this is unset/empty.
HEALTH_PORT=12564
# Legacy alias: defaults to HEALTH_PORT when unset.
BOT_HEALTH_PORT=12564
BASE_ADDRESS=/health
# Watchdog: if no poll/dispatch progress is observed for this many seconds, exit
# so Docker's restart policy recovers the bot (0 disables — not recommended).
HEALTH_WATCHDOG_SECONDS=300
# Optional dead-man's-switch ping URL (healthchecks.io or self-hosted). The bot
# GETs it after every successful poll cycle (60 s interval, 4 s timeout); an
# absent ping is what pages Atur.
# Leave empty to disable. NEVER put the URL in the public repo — set it on the host.
HEARTBEAT_URL=

# --- Good-morning / good-night greetings (Asia/Tehran) ----------------------
# [required] the bot refuses to start when this is unset/empty.
SEND_GM_GN=true
# [required] the bot refuses to start when this is unset/empty.
GM_TIME=07:00
# [required] the bot refuses to start when this is unset/empty.
GN_TIME=23:00
# [required] the bot refuses to start when this is unset/empty.
GM_GROUP_ID=-1001234567890
GM_GROUP_TOPIC_ID=2

# --- Message batching (ordinary anonymous sends) ----------------------------
# A burst of messages from one sender to one recipient is delivered together
# instead of one Telegram notification per message. BATCH_WINDOW_MS is a debounce:
# every new message restarts it. 800 ms groups a deliberate burst (a person sending
# several lines as one thought leaves well under a second between them) without
# merging messages that were meant to be separate (usually >1.2 s apart). 0 turns
# batching off and restores the old immediate delivery. BATCH_MAX_WAIT_MS caps how
# long any single message can be held while the sender keeps typing;
# BATCH_MAX_MESSAGES caps the size of one batch.
BATCH_WINDOW_MS=800
BATCH_MAX_WAIT_MS=2500
BATCH_MAX_MESSAGES=10

# Media-gallery window: after the last photo/video of an album, wait this long for
# the remaining items and then send the COMPLETE gallery in one media group. Items
# arrive back to back, so 600 ms is enough; 0 disables gallery buffering.
ALBUM_WINDOW_MS=600

# Follow-up window: after a message is sent, a plain message typed within this many
# milliseconds goes to the same recipient instead of the catch-all ("متوجه نشدم").
# 0 disables it.
CONTINUE_WINDOW_MS=6000

# --- AI auto-reply (optional, OFF by default) -------------------------------
# The GM-group AI auto-reply POSTs to AI_URL server-side; leave AI_ENABLED unset/
# false to disable the feature entirely (no outbound POST, no SSRF surface).
# Only enable it once AI_URL points at a trusted, allow-listed endpoint.
AI_ENABLED=false
AI_URL=http://
AI_SESSION_ID=123456789
AI_INTERVAL=5

# --- Nightly DB backup (optional, OFF by default) ---------------------------
# When BACKUP_CHAT_ID is set, the bot sends the newest DB backup file to THAT
# chat (and only that chat — it never broadcasts) once a day at BACKUP_TIME
# (Asia/Tehran, default 02:17). Can be a personal DM (an ADMINS id) or a
# private channel/supergroup id (negative, typically -100xxxxxxxxxx) — for a
# channel, the bot must already be added there as an admin (with post
# permission) or the send just fails. Leave BACKUP_CHAT_ID empty to disable.
# This is a TERTIARY off-host copy only; it does not count toward the RPO —
# see docs/operations/BACKUP-VERIFY.md.
BACKUP_CHAT_ID=
BACKUP_TIME=02:17

# --- Callback-token keyring (optional) --------------------------------------
# Comma-separated extra secrets kept in the callback-token keyring for rotation:
# the current key comes from BOT_TOKEN; put the OLD BOT_TOKEN here before rotating
# so buttons minted before the change keep working. Empty by default.
TOKEN_KEYS=

# --- Misc -------------------------------------------------------------------
# Default donation URL. An admin can override it at runtime with
# /admin_donate link <url>, and the donation button itself is off until
# /admin_donate active.
# [required] the bot refuses to start when this is unset/empty.
DONATION_LINK="https://daramet.com/Chevalet"
